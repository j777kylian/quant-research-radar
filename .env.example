# ------------------------------------------------------------------
# quant-research-radar configuration
# Copy to .env and adjust. Never commit the real .env.
# ------------------------------------------------------------------

# --- Database -----------------------------------------------------
# PostgreSQL (production/development). The local default assumes a
# Homebrew PostgreSQL where the OS user is a superuser with no password.
DATABASE_URL=postgresql+psycopg://localhost:5432/quant_radar

# --- LLM -----------------------------------------------------------
# Provider: "fake" (deterministic, offline) or "openai_compat" (any
# OpenAI-compatible chat completions endpoint).
LLM_PROVIDER=fake
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=60

# --- HTTP ----------------------------------------------------------
HTTP_TIMEOUT_SECONDS=20
HTTP_RETRIES=2

# --- Collection bounds ---------------------------------------------
# arXiv: recent papers only, bounded.
ARXIV_MAX_ITEMS=25
ARXIV_LOOKBACK_DAYS=14
ARXIV_SEARCH_QUERY=(cat:q-fin.* OR cat:econ.GN OR cat:econ.EM) AND (abs:bitcoin OR abs:crypto OR abs:cryptocurrency OR abs:"funding rate" OR abs:"perpetual futures" OR abs:anomaly OR abs:"return predictability" OR abs:momentum OR abs:volatility OR abs:liquidity OR abs:"market microstructure" OR abs:"order flow")

# RePEc: NEP (New Economics Papers) RSS fields. Codes: fmk=Financial
# Markets, mst=Market Microstructure, ets=Econometric Time Series,
# big=Big Data, cfn=Corporate Finance, cba=Central Banking.
REPEC_FIELDS=["fmk", "mst", "ets"]
REPEC_MAX_ITEMS=25

# Hyperliquid: small liquid universe only.
HYPERLIQUID_ASSETS=["BTC", "ETH", "SOL"]
# Historical funding window to retrieve on each run (hours).
HYPERLIQUID_FUNDING_HOURS=168
# Candle window used for return/volatility derivation (hours).
HYPERLIQUID_CANDLE_HOURS=24

# --- Pipeline -------------------------------------------------------
# Max source items analyzed per bounded run.
DAILY_ANALYZE_LIMIT=20
# Where generated reports are written.
REPORT_OUTPUT_DIR=outputs
